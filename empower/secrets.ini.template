# Waters Empower Connection Configuration
# =====================================
# This file contains sensitive connection credentials for Waters Empower.
# Keep this file secure and never commit it to version control!

[empower]
# Empower database server (leave blank for default local connection)
database=

# Empower project name to connect to
project=YOUR_PROJECT_NAME

# Empower login credentials
username=YOUR_USERNAME
password=YOUR_PASSWORD

# Default instrument connection settings
node=YOUR_INSTRUMENT_NODE
system=YOUR_INSTRUMENT_SYSTEM

# Default sample set names and templates
default_template=YOUR_DEFAULT_TEMPLATE
default_sample_set=YOUR_DEFAULT_SAMPLE_SET
default_fallback_name=YOUR_FALLBACK_NAME

# =====================================
# SECURITY WARNING:
# This file contains passwords in plain text.
# Ensure proper file permissions are set:
# - Windows: Right-click → Properties → Security → Restrict access
# - Add this file to .gitignore to prevent accidental commits
# =====================================